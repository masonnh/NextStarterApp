# Change to prod variables in production

# General
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# On production, set to: https://yourdomain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth (Optional)
# Get these from Google Cloud Console after setting up OAuth credentials
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
# Note: Credentials are configured in Supabase dashboard, not required here for frontend
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret  # Keep secret; only for backend use