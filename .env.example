# Environment example for NextStarterApp

# General
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_BASE_URL_DEV=http://localhost:3000
NEXT_PUBLIC_BASE_URL_PROD=https://your-production-url.vercel.app

# Supabase (public keys for client-side and server side URL)
NEXT_PUBLIC_SUPABASE_URL_DEV=https://your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=your-public-anon-key

NEXT_PUBLIC_SUPABASE_URL_PROD=https://your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=your-public-anon-key

# Supabase service role (server-only) - keep secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Other
NEXT_PUBLIC_THIRD_PARTY_API_KEY=
################################################
#
# .env.local holds our environment variables
# go to src/lib/env.js to support our conditional environment variables
# 
# variables starting with NEXT_PUBLIC are made available to the frontend (and backend)
# variables without NEXT_PUBLIC are only available to the backend (better for security)
#
################################################


########################
### Global variables ###
########################
# The options for NEXT_PUBLIC_ENVIRONMENT are: development, production
NEXT_PUBLIC_ENVIRONMENT=TODO


###############################
### Development environment ###
###############################
## General
NEXT_PUBLIC_BASE_URL_DEV=TODO

## Supabase
NEXT_PUBLIC_SUPABASE_URL_DEV=TODO
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=TODO


##############################
### Production environment ###
##############################
## General
NEXT_PUBLIC_BASE_URL_PROD=TODO

## Supabase
NEXT_PUBLIC_SUPABASE_URL_PROD=TODO
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=TODO